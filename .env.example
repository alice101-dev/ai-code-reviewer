APP_NAME=wallet-service
APP_ENV=development

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
GIN_MODE=release
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=1048576
HTTP_TRUSTED_PROXIES=
HTTP_CORS_ALLOWED_ORIGINS=

DB_HOST=localhost
DB_PORT=5432
DB_USER=wallet
DB_PASSWORD=change-me
DB_NAME=wallet
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s
DB_SLOW_QUERY_THRESHOLD=200ms

JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ISSUER=wallet-service
JWT_AUDIENCE=wallet-api
JWT_ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12
AUTH_RATE_LIMIT_RPS=1
AUTH_RATE_LIMIT_BURST=5
AUTH_RATE_LIMIT_TTL=10m

WALLET_SUPPORTED_CURRENCIES=IDR,USD,SGD
WALLET_MAX_TOPUP_AMOUNT=1000000000
WALLET_MAX_TRANSFER_AMOUNT=500000000
WALLET_MAX_BALANCE=10000000000

LOG_LEVEL=info
LOG_FORMAT=json

TEST_DATABASE_URL=postgres://wallet:change-me@localhost:5432/wallet?sslmode=disable
